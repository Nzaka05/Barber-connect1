<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-6xl mx-auto p-4">
    <h2 class="text-3xl font-bold text-primary mb-8">Admin Console</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-surface-container p-6 rounded-2xl border border-surface-variant">
            <p class="text-on-surface-variant text-sm">Total Users</p>
            <h3 class="text-3xl font-bold text-on-surface"><%= stats.usersCount %></h3>
        </div>
        <div class="bg-surface-container p-6 rounded-2xl border border-surface-variant">
            <p class="text-on-surface-variant text-sm">Total Shops</p>
            <h3 class="text-3xl font-bold text-on-surface"><%= stats.shopsCount %></h3>
        </div>
        <div class="bg-surface-container p-6 rounded-2xl border border-surface-variant">
            <p class="text-on-surface-variant text-sm">Total Revenue</p>
            <h3 class="text-3xl font-bold text-secondary">KES <%= stats.totalRevenue %></h3>
        </div>
        <div class="bg-surface-container p-6 rounded-2xl border border-surface-variant">
            <p class="text-on-surface-variant text-sm">Platform Commission</p>
            <h3 class="text-3xl font-bold text-primary">KES <%= stats.totalCommission %></h3>
        </div>
    </div>

    <h3 class="text-xl font-bold text-on-surface mb-4">Recent Platform Activity</h3>
    <div class="bg-surface-container rounded-2xl border border-surface-variant overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-surface-variant/50 text-on-surface-variant text-xs uppercase">
                <tr>
                    <th class="px-6 py-4">Client</th>
                    <th class="px-6 py-4">Barber</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4">Date</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-surface-variant">
                <% recentBookings.forEach(booking => { %>
                    <tr class="text-sm">
                        <td class="px-6 py-4"><%= booking.client.name %></td>
                        <td class="px-6 py-4"><%= booking.barber.name %></td>
                        <td class="px-6 py-4"><span class="px-2 py-1 rounded-full bg-primary/10 text-primary text-[10px] uppercase font-bold"><%= booking.status %></span></td>
                        <td class="px-6 py-4"><%= booking.date.toDateString() %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</main>
<%- include('partials/footer', { activePage: '' }) %>
