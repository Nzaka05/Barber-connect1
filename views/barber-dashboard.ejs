<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-4xl mx-auto p-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Barber Dashboard</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-surface-container p-4 rounded-xl border border-surface-variant">
            <p class="text-on-surface-variant text-xs">Total Earnings</p>
            <h3 class="text-xl font-bold text-secondary">KES <%= stats.totalEarnings %></h3>
        </div>
        <div class="bg-surface-container p-4 rounded-xl border border-surface-variant">
            <p class="text-on-surface-variant text-xs">Bookings</p>
            <h3 class="text-xl font-bold text-on-surface"><%= stats.totalBookings %></h3>
        </div>
    </div>
    <h3 class="text-lg font-bold text-on-surface mb-4">Current Bookings</h3>
    <div class="flex flex-col gap-4">
        <% bookings.forEach(booking => { %>
            <div class="bg-surface-container p-4 rounded-xl border border-surface-variant flex justify-between items-center">
                <div>
                    <h4 class="font-bold text-on-surface"><%= booking.client.name %></h4>
                    <p class="text-on-surface-variant text-sm"><%= booking.service.name %> • <%= booking.time %></p>
                </div>
                <div class="flex gap-2">
                    <% if (booking.status === 'pending') { %>
                        <form action="/barber/update-booking" method="POST">
                            <input type="hidden" name="bookingId" value="<%= booking._id %>">
                            <input type="hidden" name="status" value="confirmed">
                            <button class="bg-secondary text-on-secondary px-3 py-1 rounded text-sm font-bold">Accept</button>
                        </form>
                    <% } else if (booking.status === 'confirmed') { %>
                        <form action="/barber/update-booking" method="POST">
                            <input type="hidden" name="bookingId" value="<%= booking._id %>">
                            <input type="hidden" name="status" value="completed">
                            <button class="bg-primary text-on-primary px-3 py-1 rounded text-sm font-bold">Complete</button>
                        </form>
                    <% } else { %>
                        <span class="text-xs font-bold uppercase text-on-surface-variant"><%= booking.status %></span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</main>
<%- include('partials/footer', { activePage: 'dashboard' }) %>
