<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-4xl mx-auto p-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Messages</h2>
    <div class="flex flex-col gap-2">
        <% conversations.forEach(conv => { %>
            <% const otherUser = conv.participants.find(p => p._id.toString() !== user.id) %>
            <a href="/messages/chat/<%= conv._id %>" class="bg-surface-container p-4 rounded-xl border border-surface-variant flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center font-bold text-primary">
                    <%= otherUser ? otherUser.name.charAt(0) : '?' %>
                </div>
                <div class="flex-grow">
                    <h3 class="font-bold text-on-surface"><%= otherUser ? otherUser.name : 'Unknown' %></h3>
                    <p class="text-on-surface-variant text-sm truncate"><%= conv.lastMessage ? conv.lastMessage.content : 'Start a conversation' %></p>
                </div>
            </a>
        <% }) %>
    </div>
</main>
<%- include('partials/footer', { activePage: 'messages' }) %>
