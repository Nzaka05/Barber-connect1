<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-2xl mx-auto flex flex-col h-[calc(100vh-160px)]">
    <% const otherUser = conversation.participants.find(p => p._id.toString() !== user.id) %>
    <div class="p-4 border-b border-surface-variant flex items-center gap-4">
        <h2 class="font-bold text-on-surface"><%= otherUser ? otherUser.name : 'Chat' %></h2>
    </div>
    <div id="chat-messages" class="flex-grow overflow-y-auto p-4 flex flex-col gap-4">
        <% messages.forEach(msg => { %>
            <div class="max-w-[80%] p-3 rounded-2xl <%= msg.sender.toString() === user.id ? 'bg-primary text-on-primary self-end rounded-tr-none' : 'bg-surface-container-high text-on-surface self-start rounded-tl-none' %>">
                <%= msg.content %>
            </div>
        <% }) %>
    </div>
    <div class="p-4 border-t border-surface-variant">
        <form id="chat-form" class="flex gap-2">
            <input type="text" id="message-input" placeholder="Type a message..." class="flex-grow bg-surface border border-surface-variant rounded-full px-4 py-2 text-on-surface outline-none focus:border-primary">
            <button type="submit" class="bg-primary text-on-primary w-10 h-10 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined">send</span>
            </button>
        </form>
    </div>
</main>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const chatMessages = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const messageInput = document.getElementById('message-input');
    const conversationId = '<%= conversation._id %>';
    const userId = '<%= user.id %>';

    socket.emit('join', userId);

    chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const content = messageInput.value.trim();
        if (content) {
            const data = {
                conversationId,
                senderId: userId,
                content,
                receiverId: '<%= otherUser ? otherUser._id : "" %>'
            };
            socket.emit('sendMessage', data);

            // Append locally
            appendMessage(content, true);
            messageInput.value = '';
        }
    });

    socket.on('message', (data) => {
        if (data.conversationId === conversationId) {
            appendMessage(data.content, false);
        }
    });

    function appendMessage(content, isMe) {
        const div = document.createElement('div');
        div.className = `max-w-[80%] p-3 rounded-2xl ${isMe ? 'bg-primary text-on-primary self-end rounded-tr-none' : 'bg-surface-container-high text-on-surface self-start rounded-tl-none'}`;
        div.textContent = content;
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    chatMessages.scrollTop = chatMessages.scrollHeight;
</script>

<%- include('partials/footer', { activePage: 'messages' }) %>
