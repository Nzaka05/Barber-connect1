<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-md mx-auto p-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Checkout</h2>
    <div class="bg-surface-container p-6 rounded-xl border border-surface-variant mb-6">
        <p class="text-on-surface-variant text-sm">Deposit Amount</p>
        <h3 class="text-3xl font-bold text-primary">KES <%= booking.depositAmount %></h3>
    </div>
    <form action="/payments/stkpush" method="POST" class="flex flex-col gap-4">
        <input type="hidden" name="bookingId" value="<%= booking._id %>">
        <div>
            <label class="block text-on-surface-variant mb-1">M-Pesa Phone Number</label>
            <input type="text" name="phone" placeholder="2547XXXXXXXX" required class="w-full bg-surface border border-surface-variant rounded-lg p-3 text-on-surface">
        </div>
        <button type="submit" class="bg-[#00b55d] text-white font-bold py-3 rounded-lg flex items-center justify-center gap-2">
            Pay with M-Pesa
        </button>
    </form>
</main>
<%- include('partials/footer', { activePage: 'home' }) %>
