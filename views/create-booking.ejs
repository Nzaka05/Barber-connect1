<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-2xl mx-auto p-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Confirm Booking</h2>
    <div class="bg-surface-container p-4 rounded-xl border border-surface-variant mb-6">
        <h3 class="font-bold text-on-surface"><%= service.name %></h3>
        <p class="text-on-surface-variant text-sm"><%= shop.name %></p>
        <p class="text-primary font-bold">KES <%= service.price %></p>
    </div>
    <form action="/bookings/create" method="POST" class="flex flex-col gap-4">
        <input type="hidden" name="shopId" value="<%= shop._id %>">
        <input type="hidden" name="serviceId" value="<%= service._id %>">
        <div>
            <label class="block text-on-surface-variant mb-1">Select Barber</label>
            <select name="barberId" required class="w-full bg-surface border border-surface-variant rounded-lg p-3 text-on-surface">
                <% barbers.forEach((barber, index) => { %>
                    <option value="<%= barber._id %>">
                        <%= barber.name %> <%= index === 0 ? '(Recommended - Least Busy)' : '' %>
                    </option>
                <% }) %>
            </select>
            <p class="text-[10px] text-primary mt-2 uppercase font-bold tracking-widest">Barbers sorted by availability & ranking</p>
        </div>
        <div>
            <label class="block text-on-surface-variant mb-1">Date</label>
            <input type="date" name="date" required class="w-full bg-surface border border-surface-variant rounded-lg p-3 text-on-surface">
        </div>
        <div>
            <label class="block text-on-surface-variant mb-1">Time</label>
            <input type="time" name="time" required class="w-full bg-surface border border-surface-variant rounded-lg p-3 text-on-surface">
        </div>
        <button type="submit" class="bg-primary text-on-primary font-bold py-3 rounded-lg mt-4">Confirm & Pay Deposit</button>
    </form>
</main>
<%- include('partials/footer', { activePage: 'home' }) %>
