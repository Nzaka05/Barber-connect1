<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-md mx-auto mt-10 p-6 bg-surface-container rounded-xl border border-surface-variant">
    <h2 class="text-2xl font-bold text-primary mb-6">Login</h2>
    <form action="/auth/login" method="POST" class="flex flex-col gap-4">
        <div>
            <label class="block text-on-surface-variant mb-1">Email</label>
            <input type="email" name="email" required class="w-full bg-surface border border-surface-variant rounded-lg p-3 text-on-surface focus:border-primary outline-none">
        </div>
        <div>
            <label class="block text-on-surface-variant mb-1">Password</label>
            <input type="password" name="password" required class="w-full bg-surface border border-surface-variant rounded-lg p-3 text-on-surface focus:border-primary outline-none">
        </div>
        <button type="submit" class="bg-primary text-on-primary font-bold py-3 rounded-lg mt-4">Login</button>
    </form>
    <p class="mt-6 text-on-surface-variant">Don't have an account? <a href="/auth/register" class="text-primary">Register</a></p>
</main>
<%- include('partials/footer', { activePage: '' }) %>
