<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-2xl mx-auto p-4">
    <div class="bg-gradient-to-br from-primary to-primary-container p-8 rounded-3xl text-on-primary-fixed mb-8">
        <p class="text-sm font-bold uppercase tracking-wider opacity-80">Your Balance</p>
        <h2 class="text-5xl font-extrabold mt-2"><%= user.loyaltyPoints %> <span class="text-2xl font-normal">Points</span></h2>
    </div>

    <h3 class="text-xl font-bold text-on-surface mb-4">How it works</h3>
    <div class="grid grid-cols-1 gap-4">
        <div class="bg-surface-container p-4 rounded-xl border border-surface-variant">
            <h4 class="font-bold text-primary">Earn 10 points</h4>
            <p class="text-on-surface-variant text-sm">For every 1,000 KES spent on bookings.</p>
        </div>
        <div class="bg-surface-container p-4 rounded-xl border border-surface-variant">
            <h4 class="font-bold text-primary">Refer a friend</h4>
            <p class="text-on-surface-variant text-sm">Earn 50 points when they complete their first booking.</p>
        </div>
    </div>
</main>
<%- include('partials/footer', { activePage: 'profile' }) %>
