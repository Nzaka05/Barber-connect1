<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-4xl mx-auto p-4">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-primary">Manage Services</h2>
        <button class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold">Add New</button>
    </div>
    <div class="flex flex-col gap-4">
        <% services.forEach(service => { %>
            <div class="bg-surface-container p-4 rounded-xl border border-surface-variant flex justify-between items-center">
                <div>
                    <h4 class="font-bold text-on-surface"><%= service.name %></h4>
                    <p class="text-on-surface-variant text-sm">KES <%= service.price %></p>
                </div>
            </div>
        <% }) %>
    </div>
</main>
<%- include('partials/footer', { activePage: 'dashboard' }) %>
