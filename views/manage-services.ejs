<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="max-w-4xl mx-auto p-container-margin">
    <div class="flex justify-between items-center mb-stack-lg">
        <h2 class="font-headline-md text-headline-md text-primary">Manage Services</h2>
        <button onclick="document.getElementById('addServiceModal').classList.remove('hidden')" class="bg-primary text-on-primary px-6 py-2 rounded-lg font-bold shadow-lg">Add New Service</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
        <% services.forEach(service => { %>
            <div class="glass p-gutter rounded-2xl luxury-shadow flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <% if (service.image) { %>
                        <img src="<%= service.image %>" class="w-16 h-16 rounded-xl object-cover">
                    <% } else { %>
                        <div class="w-16 h-16 rounded-xl bg-surface-variant flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined">content_cut</span>
                        </div>
                    <% } %>
                    <div>
                        <h3 class="font-bold text-on-surface"><%= service.name %></h3>
                        <p class="text-on-surface-variant text-xs"><%= service.category %> • <%= service.duration %> mins</p>
                        <p class="text-primary font-bold mt-1">KES <%= service.price %></p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button class="text-on-surface-variant hover:text-primary"><span class="material-symbols-outlined">edit</span></button>
                    <button class="text-on-surface-variant hover:text-error"><span class="material-symbols-outlined">delete</span></button>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- Add Service Modal -->
    <div id="addServiceModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-surface-container-high w-full max-w-md rounded-3xl border border-surface-variant p-8 luxury-shadow">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-primary">Add New Service</h3>
                <button onclick="document.getElementById('addServiceModal').classList.add('hidden')" class="text-on-surface-variant"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form action="/barber/add-service" method="POST" enctype="multipart/form-data" class="flex flex-col gap-4">
                <input type="hidden" name="shopId" value="<%= shop._id %>">
                <div>
                    <label class="block text-on-surface-variant mb-1 text-sm font-bold">Service Name</label>
                    <input type="text" name="name" required class="w-full bg-surface border border-surface-variant rounded-xl p-3 text-on-surface outline-none focus:border-primary">
                </div>
                <div>
                    <label class="block text-on-surface-variant mb-1 text-sm font-bold">Category</label>
                    <select name="category" class="w-full bg-surface border border-surface-variant rounded-xl p-3 text-on-surface outline-none focus:border-primary">
                        <option value="Haircut">Haircut</option>
                        <option value="Beard">Beard</option>
                        <option value="Facial">Facial</option>
                        <option value="Massage">Massage</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div>
                    <label class="block text-on-surface-variant mb-1 text-sm font-bold">Description</label>
                    <textarea name="description" class="w-full bg-surface border border-surface-variant rounded-xl p-3 text-on-surface outline-none focus:border-primary"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-on-surface-variant mb-1 text-sm font-bold">Duration (mins)</label>
                        <input type="number" name="duration" required class="w-full bg-surface border border-surface-variant rounded-xl p-3 text-on-surface outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-on-surface-variant mb-1 text-sm font-bold">Price (KES)</label>
                        <input type="number" name="price" required class="w-full bg-surface border border-surface-variant rounded-xl p-3 text-on-surface outline-none focus:border-primary">
                    </div>
                </div>
                <div>
                    <label class="block text-on-surface-variant mb-1 text-sm font-bold">Service Image</label>
                    <input type="file" name="image" class="w-full text-on-surface-variant text-sm mt-1">
                </div>
                <button type="submit" class="bg-gradient-to-r from-primary to-primary-container text-on-primary-fixed font-bold py-4 rounded-xl mt-6 shadow-lg uppercase tracking-widest text-sm">Save Service</button>
            </form>
        </div>
    </div>
</main>

<%- include('partials/footer', { activePage: 'dashboard' }) %>
