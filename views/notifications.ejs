<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-2xl mx-auto p-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Notifications</h2>
    <div class="flex flex-col gap-4">
        <% if (notifications.length === 0) { %>
            <p class="text-on-surface-variant">No notifications.</p>
        <% } %>
        <% notifications.forEach(notif => { %>
            <div class="p-4 rounded-xl border border-surface-variant <%= notif.read ? 'bg-surface' : 'bg-surface-container-high border-primary/30' %>">
                <h3 class="font-bold text-on-surface"><%= notif.title %></h3>
                <p class="text-on-surface-variant text-sm"><%= notif.message %></p>
                <p class="text-[10px] text-outline mt-2"><%= notif.createdAt.toLocaleString() %></p>
            </div>
        <% }) %>
    </div>
</main>
<%- include('partials/footer', { activePage: '' }) %>
