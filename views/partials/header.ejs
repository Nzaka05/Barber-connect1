<header class="bg-neutral-950 flex justify-between items-center px-6 py-3 w-full sticky top-0 z-40">
    <div class="flex items-center gap-4">
        <a href="/" class="text-lg font-bold text-yellow-500">BarberConnect</a>
    </div>
    <div class="flex items-center gap-4">
        <% if (user) { %>
            <span class="text-on-surface-variant text-sm"><%= user.name %></span>
            <a href="/auth/logout" class="text-primary text-sm font-bold">Logout</a>
        <% } else { %>
            <a href="/auth/login" class="text-primary text-sm font-bold">Login</a>
        <% } %>
    </div>
</header>

<div class="max-w-4xl mx-auto px-4 mt-4">
    <% if (success_msg != '') { %>
        <div class="bg-secondary/10 text-secondary p-3 rounded-lg border border-secondary/20 mb-4"><%= success_msg %></div>
    <% } %>
    <% if (error_msg != '') { %>
        <div class="bg-error/10 text-error p-3 rounded-lg border border-error/20 mb-4"><%= error_msg %></div>
    <% } %>
</div>
