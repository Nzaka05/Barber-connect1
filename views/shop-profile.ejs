<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-4xl mx-auto p-4">
    <h2 class="text-3xl font-bold text-primary mb-2"><%= shop.name %></h2>
    <p class="text-on-surface-variant mb-6"><%= shop.address %></p>
    <h3 class="text-xl font-bold text-on-surface mb-4">Services</h3>
    <div class="flex flex-col gap-4">
        <% services.forEach(service => { %>
            <div class="bg-surface-container p-4 rounded-xl border border-surface-variant flex justify-between items-center">
                <div>
                    <h4 class="font-bold text-on-surface"><%= service.name %></h4>
                    <p class="text-on-surface-variant text-sm"><%= service.duration %> mins</p>
                    <p class="text-primary font-bold">KES <%= service.price %></p>
                </div>
                <a href="/bookings/create?shopId=<%= shop._id %>&serviceId=<%= service._id %>" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold">Book</a>
            </div>
        <% }) %>
    </div>
</main>
<%- include('partials/footer', { activePage: 'home' }) %>
