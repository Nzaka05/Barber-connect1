<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-4xl mx-auto p-4">
    <div class="flex justify-between items-start mb-2">
        <div>
            <h2 class="text-3xl font-bold text-primary"><%= shop.name %></h2>
            <p class="text-on-surface-variant"><%= shop.address %></p>
        </div>
        <form action="/barber/follow/<%= shop.owner._id %>" method="POST">
            <button type="submit" class="glass px-4 py-2 rounded-xl text-xs font-bold text-primary border border-primary/20 hover:bg-primary/10 transition-colors">
                Follow Barber
            </button>
        </form>
    </div>

    <!-- Real-Time Queue Component -->
    <div class="glass p-6 rounded-3xl luxury-shadow mb-8 flex justify-between items-center border-l-4 <%= queue.waitTime > 30 ? 'border-error' : 'border-secondary' %>">
        <div>
            <p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant opacity-70">Current Queue</p>
            <h3 class="text-2xl font-black text-on-surface mt-1"><%= queue.size %> People Waiting</h3>
            <% if (queue.waitTime > 0) { %>
                <p class="text-sm <%= queue.waitTime > 30 ? 'text-error' : 'text-secondary' %> font-bold mt-1">Est. Wait: <%= queue.waitTime %> mins</p>
            <% } else { %>
                <p class="text-sm text-secondary font-bold mt-1">Available Now - No Wait</p>
            <% } %>
        </div>
        <div class="text-right">
            <% if (queue.isFull) { %>
                <span class="bg-error/10 text-error text-[10px] font-bold px-3 py-1 rounded-full uppercase">Busy</span>
                <form action="/shop/waitlist" method="POST" class="mt-2">
                    <input type="hidden" name="shopId" value="<%= shop._id %>">
                    <input type="hidden" name="serviceId" value="<%= services[0]._id %>">
                    <button type="submit" class="text-[10px] text-primary underline font-bold">Join Waitlist</button>
                </form>
            <% } else { %>
                <span class="bg-secondary/10 text-secondary text-[10px] font-bold px-3 py-1 rounded-full uppercase">Accepting</span>
            <% } %>
        </div>
    </div>

    <h3 class="text-xl font-bold text-on-surface mb-4">Services</h3>
    <div class="flex flex-col gap-4">
        <% services.forEach(service => { %>
            <div class="bg-surface-container p-4 rounded-xl border border-surface-variant flex justify-between items-center">
                <div>
                    <h4 class="font-bold text-on-surface"><%= service.name %></h4>
                    <p class="text-on-surface-variant text-xs mb-1">
                        Est: <%= service.duration || '30' %> mins
                        <% if (shop.owner && shop.owner.performanceMetrics && shop.owner.performanceMetrics.avgSpeedFactor < 0.9) { %>
                            <span class="text-secondary ml-1 font-bold">• Expert Speed</span>
                        <% } %>
                    </p>
                    <p class="text-primary font-bold">KES <%= service.price %></p>
                </div>
                <a href="/bookings/create?shopId=<%= shop._id %>&serviceId=<%= service._id %>" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold">Book</a>
            </div>
        <% }) %>
    </div>

    <!-- Review Modal -->
    <section class="mt-12 mb-12">
        <h3 class="text-xl font-bold text-on-surface mb-6">Leave a Review</h3>
        <form action="/shop/review" method="POST" class="glass p-6 rounded-3xl luxury-shadow">
            <input type="hidden" name="shopId" value="<%= shop._id %>">
            <div class="mb-4">
                <label class="block text-on-surface-variant text-xs font-bold uppercase mb-2">Rating</label>
                <select name="rating" class="w-full bg-surface border border-surface-variant rounded-xl p-3 text-on-surface">
                    <option value="5">5 Stars - Excellent</option>
                    <option value="4">4 Stars - Very Good</option>
                    <option value="3">3 Stars - Good</option>
                    <option value="2">2 Stars - Fair</option>
                    <option value="1">1 Star - Poor</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-on-surface-variant text-xs font-bold uppercase mb-2">Comment</label>
                <textarea name="comment" class="w-full bg-surface border border-surface-variant rounded-xl p-3 text-on-surface outline-none focus:border-primary" rows="3"></textarea>
            </div>
            <button type="submit" class="bg-primary text-on-primary-fixed font-bold py-3 px-6 rounded-xl shadow-lg">Submit Review</button>
        </form>
    </section>
</main>
<%- include('partials/footer', { activePage: 'home' }) %>
